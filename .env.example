# GatherWise Environment Configuration Template
# Copy this file to .env for local development or configure these variables in Render.

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------

# Gemini API Key (Backend only, never exposed to client browsers)
# If omitted or left empty, GatherWise automatically runs in deterministic demo/offline mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Server host and port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Allowed CORS Origins (Comma-separated, no trailing slashes)
# In production on Render, set this to your frontend Static Site URL:
# e.g. https://gatherwise.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database file path (e.g. /var/data/gatherwise.db if using a Render persistent disk)
DATABASE_PATH=gatherwise.db

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite React - set during build in Render Static Site)
# ------------------------------------------------------------------------------

# Base URL pointing to the deployed backend Web Service (Render adds HTTPS)
# e.g. https://gatherwise-api.onrender.com
# If omitted locally, Vite dev server proxies /api requests to http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
